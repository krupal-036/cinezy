{
    "name": "cinezy",
    "version": "1.0.0",
    "scripts": {
        "dev:backend": "tsx watch index.ts",
        "build:backend": "tsc",
        "generate:sitemap": "node scripts/generate-sitemap.js",
        "start": "node dist/index.js",
        "build:frontend": "cd frontend && npm run build",
        "clean": "shx rm -rf public && shx mkdir public",
        "copy": "shx cp -r frontend/dist/* public/",
        "build": "npm run build:backend && npm run clean && npm run build:frontend && npm run copy && npm run generate:sitemap",
        "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"tsx watch index.ts\" \"cd frontend && npm run dev\""
    },
    "dependencies": {
        "axios": "^1.16.1",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^7.1.4",
        "zod": "^3.22.4"
    },
    "devDependencies": {
        "@types/cors": "^2.8.17",
        "@types/express": "^4.17.21",
        "@types/node": "^20.10.0",
        "tsx": "^4.6.2",
        "typescript": "^5.3.2",
        "concurrently": "^9.2.1",
        "shx": "^0.4.0"
    },
    "type": "module"
}